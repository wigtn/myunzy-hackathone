# ── 면지 web (FE + BFF) 환경변수 ──
# BFF가 프록시할 Python 에이전트 서비스 주소.
#   - 비어있음  → BFF 내장 TS mock 엔진으로 단독 데모 (프론트만 띄워도 완주)
#   - 주소 지정 → 해당 에이전트 서비스로 프록시 (mock LLM → 팀원 EXAONE로 무중단 승격)
AGENT_SERVICE_URL=

# 업로드 파일 최대 용량(바이트). 기본 10MB.
MAX_UPLOAD_BYTES=10485760

# ── 실 STT(Qwen3 ASR) — BFF 단독 경로(AGENT_SERVICE_URL 미설정)에서 음성 전사에 사용 ──
# STT 서버는 HTTP이므로 반드시 서버사이드(BFF)에서 호출(mixed-content 회피).
# 미설정 시 음성 턴은 캔드 transcript로 폴백. docs/prd/stt_서비스_명세서.md 참고.
# STT_BASE_URL=<비공개 — .env 에만 설정>
# STT_API_KEY=<your-key>
# STT_LANGUAGE=ko
# STT_HOTWORDS=면지,STAR

# ── 실 TTS(Qwen3-TTS) — 면접관 응답을 음성으로 합성 (BFF /api/v1/tts 경유) ──
# TTS 서버도 HTTP이므로 BFF가 대리 호출(mixed-content 회피). 브라우저는 audio/wav를 직접 재생.
# 미설정/실패 시 브라우저 내장 SpeechSynthesis로 자동 폴백. docs/prd/tts_서비스_명세서.md 참고.
# TTS_BASE_URL=<비공개 — .env 에만 설정>
# TTS_VOICE=teacher_female_kr   # 보이스 ID (한글 가능: 청년남_시크 등). 미지정 시 teacher_female_kr
# TTS_LANGUAGE=Korean         # Korean | English | Chinese | Japanese | Auto
