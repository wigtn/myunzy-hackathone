# ── 면지 에이전트 서비스 환경변수 ──
# LLM 어댑터: mock(기본) | openai/gpt(실 생성형, 키 필요) | exaone
LLM_PROVIDER=mock

# 하네스: 미설정(기본, 결정론 부트스트랩) | deepagents
#   deepagents → 부트스트랩 컨텍스트 수집을 실제 DeepAgents 에이전트로
#   (wrap_tool_call·wrap_model_call·write_todos + EXAONE model). 실패 시 자동 폴백.
#   requirements 의 deepagents/langchain 설치 필요. 질문 생성 경로엔 영향 없음.
# HARNESS=deepagents
# OPENAI_API_KEY=        # LLM_PROVIDER=openai 일 때 (EXAONE 준비 전 GPT로 테스트)
# OPENAI_MODEL=gpt-4o-mini

# 업로드 최대 용량(바이트)
MAX_UPLOAD_BYTES=10485760

# ── STT 공급자: mock(기본) | qwen3 ──
# qwen3 선택 시 STT_BASE_URL 필수. docs/prd/stt_서비스_명세서.md 참고.
STT_PROVIDER=mock
# STT_BASE_URL=<비공개 — .env 에만 설정>
# STT_API_KEY=<your-key>
# STT_LANGUAGE=ko
# STT_HOTWORDS=면지,STAR

# ── TTS (Qwen3-TTS) — GET /api/v1/tts 가 대리 호출. docs/prd/tts_서비스_명세서.md ──
# TTS_BASE_URL 미설정 시 503 → 프론트가 브라우저 SpeechSynthesis 로 폴백(동작은 유지).
# 인증 키 없음(공개 주소). 보이스 23종은 명세서 참고(예: 청년남_시크, 청년여_매혹).
TTS_BASE_URL=<비공개 — .env 에만 설정>
TTS_VOICE=teacher_female_kr
TTS_LANGUAGE=Korean
# TTS_TIMEOUT=20

# ── EXAONE-4.5-33B (LLM_PROVIDER=exaone) — OpenAI 호환 vLLM 서버 ──
# 명세: <비공개>. enable_thinking=false 강제(어댑터 내장), temp 0.3.
EXAONE_BASE_URL=<비공개 — .env 에만 설정>
EXAONE_MODEL=exaone
# EXAONE_API_KEY=        # 현재 서버 인증 없음. 키 생기면 채울 것
# EXAONE_TEMPERATURE=0.3
# EXAONE_TIMEOUT=20

# ── 외부 어댑터 provider 토글 (기본 mock, 키 있으면 실연동) ──
# 실로 켜려면: OCR_PROVIDER=miso / JOB_PROVIDER=rocketpunch / RANK_PROVIDER=genrank / GW_PROVIDER=apifuse
# 초기화 실패(키 미설정 등) 시 자동 mock 폴백. (STT_PROVIDER 와 동일 패턴)
OCR_PROVIDER=mock
JOB_PROVIDER=mock
RANK_PROVIDER=mock
GW_PROVIDER=mock

# ── 외부 API 키 (mock-first: 명세는 행사 당일 도착 → 도착 전 mock) ──
# 키는 백엔드 env 에만 보관, 프론트 노출 절대 금지 (PRD §4.5)
# MISO 이력서 OCR — base는 비밀키 아닌 공개 주소. 실엔드포인트가 비표준(/ext/v1)이라 변수로 명시.
MISO_BASE_URL=https://api.miso.gs/ext/v1
# MISO_OCR_KEY=        # 개인 발급 비밀키 (app-...)
# ROCKETPUNCH_KEY=
# APIFUSE_KEY=
# GENRANK_BASE=
# ALIGNER_URL=
